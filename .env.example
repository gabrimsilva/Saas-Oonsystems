# ========================================
# Configurações do Supabase
# ========================================
# IMPORTANTE: NUNCA commite o arquivo .env com credenciais reais!
# Este é apenas um exemplo. Copie para .env e preencha com suas credenciais.

# URL do projeto Supabase (encontre em: Project Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima do Supabase (encontre em: Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=sua_chave_publica_anonima_aqui

# ========================================
# Configurações do Sistema
# ========================================
VITE_APP_NAME=OonSystems
VITE_APP_VERSION=1.0.0

# ========================================
# Configurações Opcionais
# ========================================
# Mercado Pago (para pagamento PIX)
# VITE_MERCADO_PAGO_PUBLIC_KEY=sua_public_key_aqui

# Google Maps (para geolocalização)
# VITE_GOOGLE_MAPS_API_KEY=sua_api_key_aqui

# ========================================
# Google Analytics 4 - Edge Function
# ========================================
# IMPORTANTE: Estas variáveis devem ser configuradas como SECRETS no Supabase
# Use: supabase secrets set NOME_DA_VARIAVEL="valor"
# 
# Property ID do Google Analytics (número, ex: 123456789)
# GA4_PROPERTY_ID=123456789
#
# Email da Service Account (ex: analytics-api-service@seu-projeto.iam.gserviceaccount.com)
# GA4_SERVICE_ACCOUNT_EMAIL=analytics-api-service@seu-projeto.iam.gserviceaccount.com
#
# Chave privada da Service Account (mantenha as quebras de linha \n)
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
